{
  "name": "Kutumb Viewer",
  "short_name": "Kutumb",
  "description": "Open an exported .ftree file and see your whole family on one screen. Runs entirely on this device.",
  "id": "/playground/",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
  "orientation": "any",
  "background_color": "#f7f6f1",
  "theme_color": "#f7f6f1",
  "icons": [
    { "src": "icons/icon-192.png", "sizes": "192x192", "type": "image/png" },
    { "src": "icons/icon-512.png", "sizes": "512x512", "type": "image/png" }
  ],
  "file_handlers": [
    {
      "action": "./",
      "accept": { "application/zip": [".ftree"] }
    }
  ]
}
